# Copy to .env.local and fill in. Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ----------------------------------
# Local stack: values printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server only. Bypasses RLS: used exclusively in src/server/admin (account deletion).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Anti-abuse for anonymous sessions (Cloudflare Turnstile) ----------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Local Supabase Auth providers (read by supabase/config.toml) -------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_CAPTCHA_SECRET=

# --- Later phases --------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
